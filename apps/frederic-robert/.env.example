# ============================================================================
# Frederic Robert Hub - Environment Variables
# ============================================================================
# Sanity CMS (shared project with jazz-bands)
SANITY_PROJECT_ID=94fpfdn8
SANITY_DATASET=production
SANITY_API_READ_TOKEN=<token>

# Cache proxy (redirects API calls through local server for caching)
SANITY_PROXY_URL=http://localhost:5174/sanity

# Shared secret for cache purge (POST /__purge)
SANITY_PURGE_TOKEN=<token>

# Base URL pattern for the band sites ({slug} is replaced by the band slug)
# Example: https://{slug}.jazz.wildredbeard.tech
BAND_URL_PATTERN=https://{slug}.jazz.wildredbeard.tech

# Server
PORT=5174
NODE_ENV=production

# Analytics (optional — website id from the shared Umami instance)
# UMAMI_WEBSITE_ID=
