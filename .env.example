# ============================================================================
# ROOT .env — Source of truth for docker-compose
# ============================================================================
# All services source this file via `env_file: .env`
# Copy to `.env` and fill in your actual values.

# ============================================================================
# MANAGER SERVICES (legacy stack)
# ============================================================================
MANAGR_API_URL=http://localhost:3092
MANAGR_WEB_URL=http://localhost:3091
MANAGR_API_KEY="your-api-key"

# ============================================================================
# SANITY CMS
# ============================================================================
SANITY_PROJECT_ID=your-project-id
SANITY_READ_TOKEN=your-read-token
SANITY_WRITE_TOKEN=your-write-token

# Sanity Studio auto-injection
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=staging

# Sanity Vite client (VITE_ prefix for client-side access)
VITE_SANITY_STUDIO_PROJECT_ID=your-project-id
VITE_SANITY_STUDIO_DATASET=staging

# Sanity API proxy (cache SSR/bot requests)
SANITY_PROXY_URL=http://localhost:5173/sanity

# Cache purge token
# Generate: openssl rand -hex 32
SANITY_PURGE_TOKEN=
SANITY_STUDIO_PURGE_DOMAIN=

# ============================================================================
# MONGODB — Legacy data extraction & legacy apps
# ============================================================================
MONGODB_HOST=mongo:27017
MONGODB_ROOT_PASSWORD=

MONGODB_BOHEME_PASSWORD=
MONGODB_MPQUARTET_PASSWORD=
MONGODB_JAZZOLA_PASSWORD=
MONGODB_SWINGFAMILY_PASSWORD=
MONGODB_TRIORSH_PASSWORD=
MONGODB_WESTSIDETRIO_PASSWORD=
MONGODB_MANAGR_PASSWORD=

# ============================================================================
# POSTGRESQL — Shared DB (Umami + managr-api)
# Generate: openssl rand -base64 24
# ============================================================================
POSTGRES_USER=umami
POSTGRES_DB=umami
POSTGRES_PASSWORD=
POSTGRES_MANAGR_PASSWORD=

# Managr API database connection
DATABASE_URL=postgres://managr:MANAGR_PASSWORD@postgres:5432/managr

# ============================================================================
# UMAMI — Analytics
# Generate: openssl rand -base64 32
# ============================================================================
UMAMI_APP_SECRET=
UMAMI_ANALYTICS_DOMAINS=your-domain.com,*.your-domain.com

# Umami website IDs per band (dev environments)
# Create in Umami dashboard after deploying
UMAMI_WEBSITE_ID_BOHEME_DEV=
UMAMI_WEBSITE_ID_CANTO_DEV=
UMAMI_WEBSITE_ID_JAZZOLA_DEV=
UMAMI_WEBSITE_ID_SWING_FAMILY_DEV=
UMAMI_WEBSITE_ID_TRIO_RSH_DEV=
UMAMI_WEBSITE_ID_WEST_SIDE_TRIO_DEV=

